AGENT_HOST=127.0.0.1
AGENT_PORT=9443
AGENT_SECRET=replace-with-random-secret
AGENT_MAX_CLOCK_SKEW_SECONDS=120
# For remote access bind only to a private VPN address, or configure TLS and a firewall allowlist.
AGENT_TLS_CERT=
AGENT_TLS_KEY=
VPN_USERS_FILE=/etc/assistant-node/vpn-users.json
VPN_TIMEZONE=Asia/Tehran
