# Required
OPENAI_API_KEY=sk-...

# Pick a Responses API model available to your OpenAI project.
# Current OpenAI docs examples use gpt-5.6; change this if your account exposes a different model.
OPENAI_MODEL=gpt-5.6

PORT=8787
HOST=0.0.0.0

# Strong random secret shared only with your phone app. Recommended for any non-local deployment.
ASSISTANT_APP_TOKEN=replace-with-a-long-random-secret

# Optional stable, privacy-preserving identifier for your single-user assistant.
ASSISTANT_USER_ID=personal-assistant

# Set to false only if you replace previous_response_id with your own conversation-state storage.
OPENAI_STORE_RESPONSES=true
