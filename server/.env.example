# OpenAI stays only on the VPS.
OPENAI_API_KEY=

# Biyok voice pipeline.
BIYOK_TEXT_MODEL=gpt-5.6-luna
BIYOK_TRANSCRIPTION_MODEL=gpt-transcribe
# Optional override; default is server/config/biyok.json
# BIYOK_CONFIG_FILE=/opt/assistant/server/config/biyok.json

PORT=8787
HOST=127.0.0.1

# Required for authenticated Android requests. server/install.sh generates this.
ASSISTANT_APP_TOKEN=replace-with-a-long-random-secret
