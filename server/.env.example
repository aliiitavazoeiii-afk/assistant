# OpenAI can stay empty until API billing is active.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_STORE_RESPONSES=true
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_TTS_SPEED=0.94
# Optional override. Keep this one line when used.
# OPENAI_TTS_INSTRUCTIONS=Speak as a native Iranian Persian speaker in natural conversational Farsi.

PORT=8787
HOST=127.0.0.1
ASSISTANT_TIMEZONE=Asia/Tehran
ASSISTANT_USER_ID=ali-personal-assistant

# Required for Android/control-plane requests. server/install.sh generates this.
ASSISTANT_APP_TOKEN=replace-with-a-long-random-secret

# Safety gates: keep false until explicitly enabled.
ASSISTANT_ALLOW_AUTOMATION_CHANGES=false
ASSISTANT_ALLOW_INTEGRATION_WRITES=false
ASSISTANT_ALLOW_MESSAGES=false

# Optional outbound messaging provider. Receives {recipient,message,user}.
ASSISTANT_MESSAGE_WEBHOOK=
ASSISTANT_MESSAGE_WEBHOOK_TOKEN=

# Per-node secrets referenced by config/nodes.json
# ASSISTANT_NODE_VPN1_SECRET=
